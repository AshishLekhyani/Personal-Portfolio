---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout title="Page not found - Ashish Lekhyani" noindex>
  <main>
    <section class="mx-auto flex max-w-2xl flex-col items-start px-6 pb-32 pt-10 sm:pt-14">
      <div class="flex w-full items-center justify-between">
        <p class="text-xs font-semibold tracking-[0.08em] text-accent uppercase">404</p>
        <ThemeToggle />
      </div>
      <h1 class="mt-6 font-serif text-3xl italic text-ink">Nothing here.</h1>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
        The page you're looking for doesn't exist, or moved somewhere else.
      </p>
      <a href="/" class="link mt-6 text-sm text-ink-soft">← back home</a>
    </section>
  </main>
  <Footer />
</Layout>
