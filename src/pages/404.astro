---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Ashish Lekhyani" noindex>
  <Header />
  <main>
    <section class="mx-auto flex max-w-2xl flex-col items-start px-6 py-32">
      <p class="font-mono text-xs tracking-[0.08em] text-accent uppercase [font-variant-ligatures:none]">404</p>
      <h1 class="mt-3 font-serif text-3xl italic text-ink">Nothing here.</h1>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
        The page you're looking for doesn't exist, or moved somewhere else.
      </p>
      <a href="/" class="link mt-6 font-mono text-sm text-ink-soft [font-variant-ligatures:none]">← back home</a>
    </section>
  </main>
  <Footer />
</Layout>
