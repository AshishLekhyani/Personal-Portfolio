---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectList from '../components/ProjectList.astro';
import ExperienceRow from '../components/ExperienceRow.astro';
import PostCard from '../components/PostCard.astro';
import Footer from '../components/Footer.astro';
import ResumePrint from '../components/ResumePrint.astro';
import { projects } from '../data/projects';
import { experience, volunteering } from '../data/experience';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <Header />
  <main>
    <Hero />

    <section id="projects" data-print-hide class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
      <h2 class="font-serif text-[17px] text-accent italic">projects</h2>
      <div class="mt-6">
        <ProjectList projects={projects} lead={2} />
      </div>
    </section>

    <section id="experience" data-print-hide class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
      <h2 class="font-serif text-[17px] text-accent italic">experience</h2>
      <div class="mt-6">
        {experience.map((item) => <ExperienceRow {...item} />)}
      </div>

      <h3 class="mt-10 font-serif text-[15px] text-accent italic">volunteering</h3>
      <div class="mt-4">
        {volunteering.map((item) => <ExperienceRow {...item} />)}
      </div>
    </section>

    <section id="writing" data-print-hide class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-[17px] text-accent italic">writing</h2>
        <a href="/writing" class="link font-mono text-xs text-ink-soft [font-variant-ligatures:none]">all posts →</a>
      </div>
      <div class="mt-6">
        {posts.length > 0 ? (
          posts.map((post) => (
            <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} />
          ))
        ) : (
          <p class="text-sm text-ink-soft">Nothing published yet — check back soon.</p>
        )}
      </div>
    </section>

    <ResumePrint />
  </main>
  <Footer />
</Layout>
