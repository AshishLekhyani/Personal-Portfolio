---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceRow from '../components/ExperienceRow.astro';
import PostCard from '../components/PostCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { experience, education } from '../data/experience';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <Header />
  <main>
    <Hero />

    <section id="projects" class="mx-auto max-w-2xl px-6 py-10">
      <h2 class="text-lg font-medium">Projects</h2>
      <div class="mt-6">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-2xl px-6 py-10">
      <h2 class="text-lg font-medium">Experience</h2>
      <div class="mt-6">
        {experience.map((item) => <ExperienceRow {...item} />)}
      </div>

      <h3 class="mt-10 text-sm font-medium text-[var(--color-text-muted)]">Education</h3>
      <div class="mt-4">
        {education.map((item) => (
          <ExperienceRow role={item.degree} org={item.org} dates={item.dates} description={item.detail} />
        ))}
      </div>
    </section>

    <section id="writing" class="mx-auto max-w-2xl px-6 py-10">
      <div class="flex items-baseline justify-between">
        <h2 class="text-lg font-medium">Writing</h2>
        <a href="/writing" class="text-sm text-[var(--color-accent)] hover:underline">All posts →</a>
      </div>
      <div class="mt-6">
        {posts.length > 0 ? (
          posts.map((post) => (
            <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} />
          ))
        ) : (
          <p class="text-sm text-[var(--color-text-muted)]">Nothing published yet — check back soon.</p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
