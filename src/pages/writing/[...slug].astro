---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatted = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title={`${post.data.title} — Ashish Lekhyani`} description={post.data.description}>
  <Header />
  <main>
    <article class="mx-auto max-w-2xl px-6 pb-16 pt-16 sm:pt-24">
      <a href="/writing" class="text-sm text-ink-soft hover:text-ink">← Writing</a>
      <h1 class="mt-4 font-serif text-2xl italic text-ink">{post.data.title}</h1>
      <p class="mt-2 font-mono text-xs text-ink-soft [font-variant-ligatures:none]">{formatted}</p>
      <div class="prose prose-sm mt-8 max-w-none text-ink prose-headings:font-serif prose-headings:italic prose-a:text-accent">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
