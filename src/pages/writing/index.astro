---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Writing — Ashish Lekhyani" description="Notes on building full-stack products.">
  <Header />
  <main>
    <section class="mx-auto max-w-2xl px-6 pb-10 pt-16 sm:pt-24">
      <h1 class="font-serif text-2xl italic text-ink">Writing</h1>
      <p class="mt-2 text-sm text-ink-soft">Notes on building full-stack products.</p>

      <div class="mt-8">
        {posts.length > 0 ? (
          posts.map((post) => (
            <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} />
          ))
        ) : (
          <p class="text-sm text-ink-soft">Nothing published yet — check back soon.</p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
