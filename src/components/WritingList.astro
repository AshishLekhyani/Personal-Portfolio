---
import PostCard from './PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  lead?: number;
}

const { posts, lead = 2 } = Astro.props;
const numbered = posts.map((post, index) => ({ post, rank: index + 1 }));
const above = numbered.slice(0, lead);
const below = numbered.slice(lead);
---

<section id="writing" data-print-hide data-fold-section data-section="writing" class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="font-serif text-[17px] text-accent italic">writing</h2>
    {posts.length > 0 && (
      <button type="button" data-fold-all hidden class="fold-all font-mono text-[11px] tracking-[0.04em] text-ink-soft whitespace-nowrap [font-variant-ligatures:none]">show all ↓</button>
    )}
  </div>

  {posts.length === 0 ? (
    <p class="mt-6 text-sm text-ink-soft">Nothing published yet — check back soon.</p>
  ) : (
    <>
      <div class="mt-6 divide-y divide-rule-dot" data-rows>
        {above.map(({ post, rank }) => (
          <div data-rank={rank}>
            <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} number={rank} />
          </div>
        ))}
      </div>

      {below.length > 0 && (
        <details class="fold">
          <summary class="fold-line">
            <span aria-hidden="true" class="fade"></span>
            <span class="fold-label font-mono text-[11px] tracking-[0.06em] text-ink-soft whitespace-nowrap [font-variant-ligatures:none]">
              <span data-closed>{below.length} more, folded ↓</span>
              <span data-open>fold back ↑</span>
            </span>
            <span aria-hidden="true" class="edges"></span>
          </summary>

          <div class="divide-y divide-rule-dot" data-rows data-rest>
            {below.map(({ post, rank }, index) => (
              <div style={`--i:${index}`} data-rank={rank}>
                <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} number={rank} />
              </div>
            ))}
          </div>
        </details>
      )}
    </>
  )}
</section>
