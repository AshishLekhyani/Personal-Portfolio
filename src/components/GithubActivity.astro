---
// Real data (see src/data/github-activity.ts for how it's gathered/refreshed)
// — deliberately not stars/followers, since those are at 0 right now and
// would undercut rather than help. Instead: recency (are you actively
// shipping?) and stack breadth (language mix across real repos).
import { mostRecentPush, languages } from '../data/github-activity';

const days = Math.floor((Date.now() - new Date(mostRecentPush).getTime()) / 86_400_000);
const lastShipped = days <= 0 ? 'today' : days === 1 ? '1 day ago' : days < 30 ? `${days} days ago` : `${Math.floor(days / 30)} mo ago`;

const opacities = [1, 0.62, 0.38, 0.22];
---

<div class="mt-8 max-w-xl">
  <p class="font-mono text-[11px] tracking-[0.04em] text-ink-soft [font-variant-ligatures:none]">
    Last shipped <span class="text-ink">{lastShipped}</span> · stack across repos
  </p>
  <div class="mt-2 flex h-1.5 w-full overflow-hidden rounded-full bg-rule-dot/30">
    {languages.map((lang, i) => (
      <div style={`width:${lang.pct}%; background-color: color-mix(in oklab, var(--color-accent) ${opacities[i] * 100}%, transparent)`} />
    ))}
  </div>
  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-ink-soft [font-variant-ligatures:none]">
    {languages.map((lang, i) => (
      <li class="flex items-center gap-1.5">
        <span class="size-2 rounded-full" style={`background-color: color-mix(in oklab, var(--color-accent) ${opacities[i] * 100}%, transparent)`} />
        {lang.name} <span class="text-rule-solid">{lang.pct}%</span>
      </li>
    ))}
  </ul>
</div>
