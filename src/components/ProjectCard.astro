---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="border-b border-rule-dot py-6 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-sans text-base font-bold text-ink">{project.name}</h3>
    <span class="font-mono text-xs text-ink-soft [font-variant-ligatures:none]">{project.date}</span>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-ink-muted">
    {project.description}
  </p>

  <ul class="mt-3 flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <li class="rounded-full border border-rule-dot px-2.5 py-0.5 font-mono text-[11px] text-ink-soft [font-variant-ligatures:none]">
        {t}
      </li>
    ))}
  </ul>

  <div class="mt-3 flex gap-4 font-mono text-[11.5px] tracking-[0.02em] [font-variant-ligatures:none]">
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noreferrer" class="link text-ink-soft">
        live ↗
      </a>
    )}
    {project.codeUrl && (
      <a href={project.codeUrl} target="_blank" rel="noreferrer" class="link text-ink-soft">
        code ↗
      </a>
    )}
  </div>
</article>
