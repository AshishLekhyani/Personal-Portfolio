---
import type { Project } from '../data/projects';
import Figures from './Figures.astro';

interface Props {
  project: Project;
  number?: number;
}

const { project, number } = Astro.props;
const href = project.liveUrl ?? project.codeUrl;
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="relative grid grid-cols-[26px_minmax(0,1fr)] gap-x-3 py-6">
  {number !== undefined && (
    <span data-row-number class="pt-[3px] text-[13px] text-ink-soft">
      {pad(number)}
    </span>
  )}
  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-sans text-base font-bold text-ink">
        {href ? (
          <a href={href} target="_blank" rel="noreferrer" class="link">{project.name}</a>
        ) : (
          project.name
        )}
      </h3>
      <span class="text-xs text-ink-soft">{project.date}</span>
    </div>

    <p class="mt-2 text-sm leading-relaxed text-ink-muted">
      {project.description}
    </p>

    <Figures projectName={project.name} />
  </div>
</article>
