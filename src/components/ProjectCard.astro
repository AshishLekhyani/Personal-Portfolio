---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group border-b border-[var(--color-border)] py-6 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-base font-medium">
      {project.name}
      {project.featured && (
        <span class="ml-2 rounded-full bg-[var(--color-accent)]/10 px-2 py-0.5 text-xs font-medium text-[var(--color-accent)]">
          Latest
        </span>
      )}
    </h3>
    <span class="text-xs text-[var(--color-text-muted)]">{project.date}</span>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
    {project.description}
  </p>

  <ul class="mt-3 flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-text-muted)]">
        {t}
      </li>
    ))}
  </ul>

  <div class="mt-3 flex gap-4 text-sm">
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noreferrer" class="font-medium text-[var(--color-accent)] hover:underline">
        Live ↗
      </a>
    )}
    {project.codeUrl && (
      <a href={project.codeUrl} target="_blank" rel="noreferrer" class="font-medium text-[var(--color-accent)] hover:underline">
        Code ↗
      </a>
    )}
  </div>
</article>
