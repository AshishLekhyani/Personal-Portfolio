---
interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
}

const { slug, title, description, date } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={`/writing/${slug}`} class="group block border-b border-rule-dot py-5 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-sans text-sm font-bold text-ink group-hover:text-accent">{title}</h3>
    <span class="font-mono text-xs text-ink-soft [font-variant-ligatures:none]">{formatted}</span>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{description}</p>
</a>
