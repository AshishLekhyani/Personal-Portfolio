---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const navLinks = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Writing', href: '/#writing' },
];
---

<header data-print-hide class="sticky top-0 z-50 border-b border-rule-dot bg-paper/85 backdrop-blur">
  <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-0 sm:px-5 sm:py-4">
    <a href="/" class="wordmark shrink-0 font-serif text-lg italic text-ink sm:text-xl">
      {site.name}<span class="text-accent">.</span>
    </a>

    <nav class="flex items-center gap-3 font-mono text-[11px] tracking-wide text-ink-soft sm:gap-5 sm:text-xs [font-variant-ligatures:none]">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors hover:text-ink">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<div data-print-hide class="pointer-events-none fixed inset-x-0 top-0 z-[60] flex justify-center">
  <div class="pointer-events-auto">
    <ThemeToggle />
  </div>
</div>

<style>
  .wordmark {
    font-variation-settings: 'opsz' 30;
    letter-spacing: -0.01em;
  }
</style>
