---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const navLinks = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Writing', href: '/#writing' },
];
---

<header data-print-hide class="sticky top-0 z-50 border-b border-rule-dot bg-paper/85 backdrop-blur">
  <div class="flex items-center justify-between px-5 py-4">
    <a href="/" class="font-serif text-lg italic text-ink">
      {site.name}
    </a>

    <nav class="flex items-center gap-5 font-mono text-xs tracking-wide text-ink-soft [font-variant-ligatures:none]">
      {navLinks.map((link) => (
        <a href={link.href} class="hidden transition-colors hover:text-ink sm:inline">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<div data-print-hide class="pointer-events-none fixed inset-x-0 top-0 z-[60] flex justify-center">
  <div class="pointer-events-auto">
    <ThemeToggle />
  </div>
</div>
