---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const navLinks = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Articles', href: '/#articles' },
];
---

<header data-print-hide class="sticky top-0 z-50 border-b border-rule-dot bg-paper/85 backdrop-blur">
  <div class="flex items-center justify-between px-4 py-3 sm:px-5 sm:py-4">
    <a href="/" class="wordmark hidden shrink-0 font-serif text-lg italic text-ink sm:block sm:text-xl">
      {site.name}<span class="text-accent">.</span>
    </a>

    <nav class="flex items-center gap-3 font-mono text-[11px] tracking-wide text-ink-soft sm:gap-5 sm:text-xs [font-variant-ligatures:none]">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors hover:text-ink">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="sm:hidden">
      <ThemeToggle clipped={false} />
    </div>
  </div>
</header>

<div data-print-hide class="pointer-events-none fixed inset-x-0 top-0 z-[60] hidden justify-center sm:flex">
  <div class="pointer-events-auto">
    <ThemeToggle />
  </div>
</div>

<style>
  .wordmark {
    font-variation-settings: 'opsz' 30;
    letter-spacing: -0.01em;
  }
</style>
