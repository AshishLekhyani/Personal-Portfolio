---
import PostCard from './PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'articles'>[];
}

const { posts } = Astro.props;
---

<section id="articles" data-print-hide class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
  <h2 class="font-serif text-[17px] text-accent italic">articles</h2>

  {posts.length === 0 ? (
    <p class="mt-6 text-sm text-ink-soft">Nothing published yet. Check back soon.</p>
  ) : (
    <div class="mt-6 divide-y divide-rule-dot">
      {posts.map((post, index) => (
        <PostCard slug={post.id} title={post.data.title} description={post.data.description} date={post.data.date} number={index + 1} />
      ))}
    </div>
  )}
</section>
