---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" data-print-hide class="mx-auto max-w-2xl scroll-mt-20 px-6 py-10">
  <h2 class="font-serif text-[17px] text-accent italic">projects</h2>

  <div class="mt-6 divide-y divide-rule-dot">
    {projects.map((project, index) => (
      <ProjectCard project={project} number={index + 1} />
    ))}
  </div>
</section>
