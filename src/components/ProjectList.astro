---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
  lead?: number;
}

const { projects, lead = 2 } = Astro.props;
const above = projects.slice(0, lead);
const below = projects.slice(lead);
---

<div>
  {above.map((project) => <ProjectCard project={project} />)}

  {below.length > 0 && (
    <details class="fold">
      <summary class="fold-line">
        <span aria-hidden="true" class="fade"></span>
        <span class="fold-label font-mono text-[11px] tracking-[0.06em] text-ink-soft whitespace-nowrap [font-variant-ligatures:none]">
          <span data-closed>{below.length} more, folded ↓</span>
          <span data-open>fold back ↑</span>
        </span>
        <span aria-hidden="true" class="edges"></span>
      </summary>

      <div data-rest>
        {below.map((project, index) => (
          <div style={`--i:${index}`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </details>
  )}
</div>

<style>
  .fold {
    display: flex;
    flex-direction: column;
  }

  .fold-line {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .fold-line::-webkit-details-marker {
    display: none;
  }

  .fold-line::before,
  .fold-line::after {
    content: '';
    flex: 1;
    border-bottom: 0.5px dashed var(--color-rule-dot);
  }

  .fold-line:hover .fold-label {
    color: var(--color-ink);
  }

  .fold-line:focus-visible {
    outline: 1px dashed var(--color-accent);
    outline-offset: 4px;
  }

  .fold-label {
    transition: color 120ms linear;
  }

  .fold:not([open]) .fold-label {
    color: var(--color-accent);
  }

  .fade {
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: 90px;
    pointer-events: none;
    background: linear-gradient(
      to top,
      var(--color-paper) 0 30%,
      color-mix(in oklab, var(--color-paper) 75%, transparent) 58%,
      transparent 100%
    );
  }

  .fold[open] .fade,
  .fold[open] .edges,
  .fold:not([open]) [data-open],
  .fold[open] [data-closed] {
    display: none;
  }

  /* Once open, the fold line drops below the revealed rows instead of staying
     pinned where you clicked it — so closing it again doesn't mean scrolling
     back up to find it. */
  .fold[open] > summary {
    order: 2;
  }

  .fold:not([open]) > summary {
    margin-bottom: 6px;
  }

  /* Two faint creases below the fold line, hinting at rows stacked behind it. */
  .edges {
    position: absolute;
    inset-inline: 14%;
    top: calc(100% - 10px);
  }

  .edges::before,
  .edges::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    border-bottom: 0.5px dashed var(--color-rule-dot);
  }

  .edges::before {
    top: 0;
    opacity: 0.55;
  }

  .edges::after {
    top: 4px;
    inset-inline: 7%;
    opacity: 0.3;
  }

  [data-rest] > div {
    animation: unroll 300ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--i) * 22ms);
  }

  @keyframes unroll {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-rest] > div {
      animation: none;
    }
  }
</style>
