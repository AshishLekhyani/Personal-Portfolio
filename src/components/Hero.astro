---
import { site, socials, skills } from '../data/site';

const iconFor = (label: string) => {
  switch (label) {
    case 'GitHub':
      return 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.67.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 2.5-.35c.85 0 1.7.11 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.48A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z';
    case 'LinkedIn':
      return 'M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.3 8.75h3.63V21H3.3V8.75Zm6.28 0h3.48v1.68h.05c.48-.9 1.67-1.86 3.44-1.86 3.68 0 4.36 2.42 4.36 5.57V21h-3.63v-5.58c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95V21H9.58V8.75Z';
    case 'Email':
      return 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1.5 2.4V17h15V7.4l-7.06 5.65a1.5 1.5 0 0 1-1.88 0L4.5 7.4Zm.9-.9 6.6 5.28L17.6 6.5H5.4Z';
    default:
      return '';
  }
};
---

<section class="mx-auto max-w-2xl px-6 pb-14 pt-16 sm:pt-24">
  <p class="text-sm font-medium text-[var(--color-accent)]">{site.role} · Freelance</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
    {site.name}
  </h1>
  <p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--color-text-muted)]">
    {site.tagline}
  </p>

  <div class="mt-6 flex items-center gap-4">
    {socials.map((s) => (
      <a
        href={s.url}
        target={s.url.startsWith('mailto:') ? undefined : '_blank'}
        rel={s.url.startsWith('mailto:') ? undefined : 'noreferrer'}
        aria-label={s.label}
        class="text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={iconFor(s.label)} /></svg>
      </a>
    ))}
  </div>

  <ul class="mt-8 flex flex-wrap gap-2">
    {skills.map((skill) => (
      <li class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-text-muted)]">
        {skill}
      </li>
    ))}
  </ul>
</section>
