---
import { site, socials, skills } from '../data/site';
---

<section data-print-hide class="mx-auto max-w-2xl px-6 pb-14 pt-16 sm:pt-24">
  <p class="font-mono text-xs tracking-[0.08em] text-accent uppercase [font-variant-ligatures:none]">
    {site.role} · Freelance
  </p>

  <h1 class="mt-3 font-serif text-[clamp(34px,5.2vw,48px)] leading-[1.05] tracking-tight text-ink italic">
    {site.name}
  </h1>

  <p class="mt-5 max-w-xl font-serif text-lg leading-relaxed text-ink-muted italic">
    {site.tagline}
  </p>

  <p class="mt-8 font-serif text-[17px] text-accent italic">hey</p>
  <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-ink-muted">{site.status}</p>
  <p class="mt-2.5 max-w-xl text-[15px] leading-relaxed text-ink-muted">{site.intro}</p>

  <p class="mt-8 font-serif text-[17px] text-accent italic">connect</p>
  <ul class="mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-2">
    {socials.map((s) => (
      <li>
        <a
          href={s.url}
          target={s.url.startsWith('mailto:') ? undefined : '_blank'}
          rel={s.url.startsWith('mailto:') ? undefined : 'noreferrer'}
          class="link font-mono text-[11.5px] tracking-[0.02em] text-ink-soft [font-variant-ligatures:none]"
        >
          {s.label}
        </a>
      </li>
    ))}
    <li>
      <button
        type="button"
        data-print-resume
        class="print-link font-mono text-[11.5px] tracking-[0.02em] text-ink-soft [font-variant-ligatures:none]"
      >
        resume
      </button>
    </li>
  </ul>

  <ul class="mt-8 flex flex-wrap gap-2">
    {skills.map((skill) => (
      <li class="rounded-full border border-rule-dot px-3 py-1 font-mono text-[11px] text-ink-soft [font-variant-ligatures:none]">
        {skill}
      </li>
    ))}
  </ul>
</section>

<style>
  .print-link {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-accent-50);
    padding: 0 0 1px;
    cursor: pointer;
    transition: border-color 120ms linear;
  }

  .print-link:hover {
    border-color: var(--color-accent);
  }
</style>
