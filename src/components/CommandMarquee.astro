---
// Decorative only — a faint column of code drifting up the left margin,
// inspired by the ticker on git-scope-pi.vercel.app but pushed to the
// background: no borders, lowest z-index, barely-there opacity so it reads
// as texture rather than content. Only shows up once there's enough margin
// outside the content column to hold it without crowding anything.
//
// Repeated many times over (not just duplicated once) so the track is
// always taller than any real viewport — otherwise the seamless-loop trick
// (scroll one copy's height, snap back) shows a blank gap at the seam on
// tall screens, since two copies alone don't reach full-viewport height.

const lines = [
  'const key = await deriveDataKey(orgId, masterKey)',
  'type Secret = { id: string; envTier: EnvTier }',
  'export async function reveal(id: string) {',
  '  const cipher = await kms.decrypt(payload)',
  '  await audit.log({ actor, secretId: id })',
  '  return NextResponse.json({ value: cipher })',
  '}',
  'SELECT id, org_id FROM secrets WHERE env = $1',
  'CREATE INDEX idx_secrets_org ON secrets(org_id)',
  'interface Project { name: string; repo: string }',
  'const rows = await prisma.project.findMany()',
  'export default function Hero() {',
  '  return <section className="relative">',
  'const [theme, setTheme] = useState("system")',
  'app.use(cors({ origin: allowedOrigins }))',
  'CREATE TABLE audit_log (id UUID PRIMARY KEY)',
  'export const config = { runtime: "edge" }',
  'const cascade = providers.filter((p) => p.healthy)',
  'model Secret {',
  '  id        String   @id @default(cuid())',
  '  orgId     String',
  '  rotatedAt DateTime @updatedAt',
  '}',
  'async function withRetry<T>(fn: () => Promise<T>) {',
  '  const headers = { Authorization: `Bearer ${token}` }',
  'export type Theme = "system" | "light" | "dark"',
  'git diff --stat origin/main',
  'ALTER TABLE projects ADD COLUMN sort_date DATE',
  'const scanner = new CveScanner({ severity: "high" })',
  'useEffect(() => { root.classList.toggle("dark") }, [])',
  'export function encrypt(payload: Buffer, key: Buffer) {',
  '  return crypto.createCipheriv("aes-256-gcm", key, iv)',
];

const repeated = Array.from({ length: 3 }, () => lines).flat();
---

<div aria-hidden="true" data-print-hide class="pointer-events-none fixed inset-y-0 left-0 -z-10 hidden w-[280px] overflow-hidden xl:block">
  <div
    class="track flex flex-col whitespace-nowrap font-mono text-[13px] leading-[2.4] text-ink-soft/[0.2]"
    style="transform: translateY(100vh)"
  >
    {[...repeated, ...repeated].map((line) => <span class="px-6">{line}</span>)}
  </div>
</div>

<style>
  .track {
    width: max-content;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transform: none !important;
    }
  }
</style>

<script>
  (() => {
    const track = document.querySelector<HTMLElement>('.track');
    if (!track) return;

    // The hidden starting position is an inline style (so it applies before
    // any stylesheet race, even in dev mode) — a stylesheet media query can't
    // override that, so reduced-motion is handled here in JS instead.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      track.style.transform = '';
      return;
    }

    // A single time-driven rAF loop instead of CSS transition → keyframe
    // handoff. That handoff broke when window.print() interrupted it:
    // print.css hides this element (data-print-hide) while the dialog is
    // open, which abandons a running CSS transition without firing
    // transitionend, so the loop never started and the track froze wherever
    // it got hidden. Deriving position purely from elapsed wall-clock time
    // sidesteps that entirely — however long the element was hidden for,
    // the next frame that actually paints computes the mathematically
    // correct position for "now," so it resumes exactly where it should be,
    // never snapping and never getting stuck.
    const LOOP_SECONDS = 400;
    const loopDistance = track.scrollHeight / 2;
    const speedPxPerSec = loopDistance / LOOP_SECONDS;
    const enterDistance = window.innerHeight;
    const enterDurationMs = (enterDistance / speedPxPerSec) * 1000;
    const loopDurationMs = LOOP_SECONDS * 1000;
    const start = performance.now();

    const tick = (now: number) => {
      const elapsed = now - start;
      let y: number;
      if (elapsed < enterDurationMs) {
        y = enterDistance * (1 - elapsed / enterDurationMs);
      } else {
        const loopElapsed = (elapsed - enterDurationMs) % loopDurationMs;
        y = -loopDistance * (loopElapsed / loopDurationMs);
      }
      track.style.transform = `translateY(${y}px)`;
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  })();
</script>
