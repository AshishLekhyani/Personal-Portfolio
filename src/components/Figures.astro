---
// A gallery of project screenshots (and, eventually, clips) that hangs in
// the right margin next to a project row like a pile of prints: the title
// shot on top, the rest showing only their edges. Pointing at the pile
// spreads it, clicking opens the full frame in FigureViewer.
//
// Below xl there is no margin to use, so the pile lies down into a strip
// that wraps under the row — same threshold CommandMarquee uses for the
// left margin, so both sides of the page populate together.

import { shotsFor } from '../data/shots';

interface Props {
  projectName: string;
}

const { projectName } = Astro.props;
const shots = shotsFor(projectName);
---

{shots.length > 0 && (
  <span class="figures" data-fig-pile>
    {shots.map((shot, index) => (
      <a
        class:list={['fig', { clip: shot.video }]}
        href={shot.src}
        target="_blank"
        rel="noreferrer"
        data-fig-frame
        data-video={shot.video ? '' : undefined}
        data-caption={shot.caption ?? `${projectName}, frame ${index + 1}`}
        style={`--i:${index}`}
      >
        <img
          src={shot.thumb}
          width={shot.width}
          height={shot.height}
          alt={shot.caption ?? `${projectName}, frame ${index + 1}`}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
  </span>
)}

<style>
  /* No margin to hang in below xl, so the pile lies down and wraps under the
     row rather than pushing the column wider than the screen. */
  .figures {
    --sheet: 60px;
    --step: 5px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 11px 0 2px;
  }

  .fig {
    position: relative;
    flex: 0 0 auto;
    display: block;
    width: 78px;
    padding: 3px;
    border: 0.5px solid var(--color-rule-dot);
    background: var(--color-paper);
    transition:
      transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1),
      margin-top 220ms cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 160ms linear;
  }

  .fig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    opacity: 0.85;
    transition: opacity 220ms linear;
  }

  .fig:hover,
  .fig:focus-visible {
    border-color: var(--color-accent-50);
  }

  .fig:hover img,
  .fig:focus-visible img {
    opacity: 1;
  }

  /* A clip reads as a still until it is opened, so it says so with a mark in
     the corner rather than by moving in the pile. */
  .clip::after {
    content: '';
    position: absolute;
    right: 6px;
    bottom: 6px;
    border-style: solid;
    border-width: 4px 0 4px 7px;
    border-color: transparent transparent transparent var(--color-paper);
    filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.55));
  }

  /* The margin only exists once the viewport can hold it. */
  @media (min-width: 1280px) {
    /* The hit area is the row, not the pile: piles are taller than their row
       and would otherwise steal the hover from the one below. Sheets only
       take pointer events once the pile is spread.

       Width reaches all the way to the viewport edge (measured in JS, see
       the script below) rather than shrink-wrapping its sheets — that way
       overflow:hidden and the fade mask below always land at the actual
       edge of the page, however many sheets are in a given pile. */
    .figures {
      --sheet: 92px;
      position: absolute;
      top: 26px;
      bottom: 8px;
      left: calc(100% + 24px);
      width: var(--fig-avail-w, 300px);
      overflow: hidden;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 0;
      margin: 0;
      mask-image: linear-gradient(to right, black calc(100% - 64px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 64px), transparent 100%);
    }

    .fig {
      width: 92px;
      pointer-events: none;
      /* Earlier sheets sit on top, so the pile reads from the title shot
         outward. */
      z-index: calc(30 - var(--i));
    }

    .fig + .fig {
      margin-left: calc(var(--step) - var(--sheet));
    }

    /* Each pile spreads sideways within its own row's height, so unlike the
       old vertical stack there's no reach into the row above or below —
       nothing for a spread pile to collide with, so siblings stay put. */
    .figures:hover,
    .figures:has(:focus-visible) {
      z-index: 30;
    }

    .figures:hover .fig,
    .figures:has(:focus-visible) .fig {
      pointer-events: auto;
    }

    .figures:hover .fig + .fig,
    .figures:has(:focus-visible) .fig + .fig {
      margin-left: 7px;
    }

    .fig:hover,
    .fig:focus-visible {
      transform: scale(1.14);
      transform-origin: top left;
      z-index: 40;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fig,
    .fig img {
      transition: none;
    }
  }
</style>

<script>
  // Piles now spread sideways instead of stacking downward, which means a
  // full row of sheets can easily run past the actual right edge of the
  // page. The fade mask in the CSS above always sits at the last 64px of
  // this element's own box — so if that box's width is set to reach exactly
  // to the viewport edge, the fade naturally lands right at the page edge,
  // whatever the viewport width. Every pile shares the same horizontal
  // position (they all hang off the same content column), so measuring one
  // is enough for all of them.
  (() => {
    const sample = document.querySelector<HTMLElement>('.figures');
    if (!sample) return;

    const update = () => {
      if (window.innerWidth < 1280) return;
      const left = sample.getBoundingClientRect().left;
      const available = Math.max(120, window.innerWidth - left - 16);
      document.documentElement.style.setProperty('--fig-avail-w', `${available}px`);
    };

    update();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 100);
    });
  })();
</script>
