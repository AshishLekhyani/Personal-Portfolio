---
import { shotsFor } from '../data/shots';

interface Props {
  projectName: string;
}

const { projectName } = Astro.props;
const shots = shotsFor(projectName);
---

{shots.length > 0 && (
  <span class="figures" data-fig-pile>
    {shots.map((shot, index) => (
      <a
        class:list={['fig', { clip: shot.video }]}
        href={shot.src}
        target="_blank"
        rel="noreferrer"
        data-fig-frame
        data-video={shot.video ? '' : undefined}
        data-caption={shot.caption ?? `${projectName}, frame ${index + 1}`}
        style={`--i:${index}`}
      >
        <img
          src={shot.thumb}
          width={shot.width}
          height={shot.height}
          alt={shot.caption ?? `${projectName}, frame ${index + 1}`}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
  </span>
)}

<style>
  .figures {
    --sheet: 60px;
    --step: 5px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 11px 0 2px;
  }

  .fig {
    position: relative;
    flex: 0 0 auto;
    display: block;
    width: 78px;
    padding: 3px;
    border: 0.5px solid var(--color-rule-dot);
    background: var(--color-paper);
    transition:
      transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1),
      margin-left 220ms cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 160ms linear;
  }

  .fig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    opacity: 0.85;
    transition: opacity 220ms linear;
  }

  .fig:hover,
  .fig:focus-visible {
    border-color: var(--color-accent-50);
  }

  .fig:hover img,
  .fig:focus-visible img {
    opacity: 1;
  }

  .clip::after {
    content: '';
    position: absolute;
    right: 6px;
    bottom: 6px;
    border-style: solid;
    border-width: 4px 0 4px 7px;
    border-color: transparent transparent transparent var(--color-paper);
    filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.55));
  }

  @media (min-width: 1280px) {
    .figures {
      --sheet: 92px;
      position: absolute;
      top: 26px;
      bottom: 8px;
      left: calc(100% + 24px);
      width: var(--fig-avail-w, 300px);
      overflow: hidden;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 0;
      margin: 0;
      mask-image: linear-gradient(to right, black calc(100% - 64px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 64px), transparent 100%);
    }

    .fig {
      width: 92px;
      pointer-events: none;
      z-index: calc(30 - var(--i));
    }

    .fig + .fig {
      margin-left: calc(var(--step) - var(--sheet));
    }

    .figures:hover,
    .figures:has(:focus-visible) {
      z-index: 30;
    }

    .figures:hover .fig,
    .figures:has(:focus-visible) .fig {
      pointer-events: auto;
    }

    .figures:hover .fig + .fig,
    .figures:has(:focus-visible) .fig + .fig {
      margin-left: 7px;
    }

    .fig:hover,
    .fig:focus-visible {
      transform: scale(1.14);
      transform-origin: top left;
      z-index: 40;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fig,
    .fig img {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const sample = document.querySelector<HTMLElement>('.figures');
    if (!sample) return;

    const update = () => {
      if (window.innerWidth < 1280) return;
      const left = sample.getBoundingClientRect().left;
      const available = Math.max(120, window.innerWidth - left - 16);
      document.documentElement.style.setProperty('--fig-avail-w', `${available}px`);
    };

    update();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 100);
    });
  })();
</script>
