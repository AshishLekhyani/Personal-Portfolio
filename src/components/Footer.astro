---
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="contact" data-print-hide class="mx-auto max-w-2xl px-6 py-16">
  <div class="border-t border-rule-dot pt-10">
    <p class="font-serif text-[17px] text-accent italic">let's work together</p>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-muted">
      Freelancing and open to new project work. The fastest way to reach me is email.
    </p>
    <a href={`mailto:${site.email}`} class="link mt-4 inline-block font-mono text-sm text-ink-soft [font-variant-ligatures:none]">
      {site.email} ↗
    </a>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-ink-soft [font-variant-ligatures:none]">
      <p>© {year} {site.name}</p>
      <div class="flex gap-4">
        {socials.map((s) => (
          <a href={s.url} class="hover:text-ink">{s.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
