---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="contact" data-print-hide class="mx-auto max-w-2xl px-6 py-16">
  <div class="border-t border-rule-dot pt-10">
    <p class="font-serif text-[17px] text-accent italic">let's work together</p>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-muted">
      Always happy to talk shop, swap ideas, or hear what you're building. The fastest way to reach me is email.
    </p>
    <a href={`mailto:${site.email}`} class="link mt-4 inline-block text-sm text-ink-soft">
      {site.email} ↗
    </a>

    <p class="mt-10 text-xs text-ink-soft">© {year} {site.name}</p>
  </div>
</footer>
