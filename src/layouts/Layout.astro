---
import '../styles/global.css';
import '../styles/print.css';
import { site, socials, skills } from '../data/site';
import { education } from '../data/experience';
import frauncesItalicURL from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import frauncesRegularURL from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interRegularURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Ashish Lekhyani - Software Engineer',
  description = 'Ashish Lekhyani is a software engineer and full-stack developer building complete products, from database schema to the UI on top.',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const profileURLs = socials.filter((s) => !s.url.startsWith('mailto:')).map((s) => s.url);
const siteURL = Astro.site?.toString() ?? 'https://ashishlekhyani.com/';
const degree = education.find((e) => e.degree.startsWith('B.Tech'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteURL}#person`,
      name: site.name,
      url: siteURL,
      image: new URL('/og-image.png', Astro.site).toString(),
      jobTitle: [site.role, 'Full-Stack Developer'],
      description: site.intro[0],
      email: site.email,
      sameAs: profileURLs,
      knowsAbout: skills,
      alumniOf: degree && {
        '@type': 'CollegeOrUniversity',
        name: 'JECRC Foundation',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: site.name,
      description,
      author: { '@id': `${siteURL}#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#fdfdfc" />
    <link rel="preload" href={frauncesItalicURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesRegularURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interRegularURL} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ashish Lekhyani" href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme') || 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            theme === 'dark' || (theme === 'system' && prefersDark)
          );
        } catch {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelector('[data-print-resume]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
