---
import '../styles/global.css';
import '../styles/print.css';
import CommandMarquee from '../components/CommandMarquee.astro';
import { site, socials, skills } from '../data/site';
import { education } from '../data/experience';
import frauncesItalicURL from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import frauncesRegularURL from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Ashish Lekhyani — Software Engineer & Freelancer',
  description = 'Ashish Lekhyani is a software engineer, freelancer, and full-stack developer building complete products — from database schema to the UI on top.',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const profileURLs = socials.filter((s) => !s.url.startsWith('mailto:')).map((s) => s.url);
const siteURL = Astro.site?.toString() ?? 'https://ashishlekhyani.com/';
const degree = education.find((e) => e.degree.startsWith('B.Tech'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteURL}#person`,
      name: site.name,
      url: siteURL,
      image: new URL('/og-image.png', Astro.site).toString(),
      jobTitle: [site.role, 'Freelancer', 'Full-Stack Developer'],
      description: site.intro[0],
      email: site.email,
      sameAs: profileURLs,
      knowsAbout: skills,
      alumniOf: degree && {
        '@type': 'CollegeOrUniversity',
        name: 'JECRC Foundation',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: site.name,
      description,
      author: { '@id': `${siteURL}#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#fdfdfc" />
    <link rel="preload" href={frauncesItalicURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesRegularURL} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ashish Lekhyani" href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme') || 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            theme === 'dark' || (theme === 'system' && prefersDark)
          );
        } catch {}
      })();
    </script>
  </head>
  <body>
    <CommandMarquee />
    <slot />
    <script is:inline>
      document.querySelector('[data-print-resume]')?.addEventListener('click', () => window.print());
    </script>
    <script>
      document.querySelectorAll('[data-fold-section]').forEach((section) => {
        if ((section as HTMLElement).dataset.foldReady) return;
        (section as HTMLElement).dataset.foldReady = '1';

        const details = section.querySelector<HTMLDetailsElement>('details.fold');
        const foldAllBtn = section.querySelector<HTMLButtonElement>('[data-fold-all]');
        const summary = details?.querySelector<HTMLElement>(':scope > summary');
        const rest = details?.querySelector<HTMLElement>('[data-rest]');

        let animation: Animation | null = null;
        let isClosing = false;
        let isExpanding = false;

        const syncLabel = () => {
          if (!details || !foldAllBtn) return;
          foldAllBtn.textContent = details.open ? 'fold back ↑' : 'show all ↓';
          foldAllBtn.setAttribute('aria-expanded', String(details.open));
        };

        const finish = (open: boolean) => {
          if (!details) return;
          details.open = open;
          animation = null;
          isClosing = false;
          isExpanding = false;
          details.style.height = '';
          details.style.overflow = '';
          syncLabel();
        };

        const expand = () => {
          if (!details || !summary || !rest) return;
          isExpanding = true;
          details.style.overflow = 'hidden';
          const startHeight = details.offsetHeight;
          details.style.height = `${startHeight}px`;
          details.open = true;
          requestAnimationFrame(() => {
            const endHeight = summary.offsetHeight + rest.offsetHeight;
            animation?.cancel();
            animation = details.animate(
              { height: [`${startHeight}px`, `${endHeight}px`] },
              { duration: 320, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)' }
            );
            animation.onfinish = () => finish(true);
            animation.oncancel = () => {
              isExpanding = false;
            };
          });
        };

        const collapse = () => {
          if (!details || !summary) return;
          isClosing = true;
          details.style.overflow = 'hidden';
          const startHeight = details.offsetHeight;
          const endHeight = summary.offsetHeight;
          animation?.cancel();
          animation = details.animate(
            { height: [`${startHeight}px`, `${endHeight}px`] },
            { duration: 260, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)' }
          );
          animation.onfinish = () => finish(false);
          animation.oncancel = () => {
            isClosing = false;
          };
        };

        const toggle = () => {
          if (!details) return;
          if (isClosing || !details.open) expand();
          else if (isExpanding || details.open) collapse();
        };

        if (details && summary && rest) {
          summary.addEventListener('click', (e) => {
            e.preventDefault();
            toggle();
          });

          if (foldAllBtn) {
            foldAllBtn.hidden = false;
            foldAllBtn.addEventListener('click', toggle);
          }

          syncLabel();
        }

        const sortControls = section.querySelector<HTMLElement>('[data-sort-controls]');
        const leadContainer = section.querySelector<HTMLElement>('[data-rows]:not([data-rest])');

        if (sortControls && leadContainer && rest) {
          const leadCount = leadContainer.children.length;
          const key = (row: Element) => Number((row as HTMLElement).dataset.key) || 0;
          const rank = (row: Element) => Number((row as HTMLElement).dataset.rank) || 0;
          const compare: Record<string, (a: Element, b: Element) => number> = {
            relevance: (a, b) => rank(a) - rank(b),
            latest: (a, b) => key(b) - key(a) || rank(a) - rank(b),
          };

          sortControls.hidden = false;
          sortControls.addEventListener('click', (e) => {
            const option = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sort]');
            if (!option) return;

            const order = option.dataset.sort ?? 'relevance';
            const rows = [...leadContainer.children, ...rest.children];
            const sorted = rows.sort(compare[order] ?? compare.relevance);
            const pad = (n: number) => String(n).padStart(2, '0');

            sorted.forEach((row, index) => {
              (index < leadCount ? leadContainer : rest).append(row);
              const number = row.querySelector('[data-row-number]');
              if (number) number.textContent = pad(index + 1);
            });

            sortControls.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((opt) => {
              opt.setAttribute('aria-pressed', String(opt.dataset.sort === order));
            });

            if (details && !details.open) expand();
          });
        }
      });
    </script>
  </body>
</html>
